<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clOrderItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:padding="12dp"
    style="@style/ItemBasic">


    <ImageView
        android:id="@+id/ivBookPhoto"
        android:layout_width="80dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/backgrounds/scenic"
        style="@style/ImageViewBg"/>


    <TextView
        android:id="@+id/tvBookTitle"
        style="@style/TextViewParagraphLarge"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btnToCart"
        app:layout_constraintStart_toEndOf="@id/ivBookPhoto"
        app:layout_constraintTop_toTopOf="@id/ivBookPhoto"
        android:text=""
        tools:text="Где арахисы, там и зима"/>


    <ImageButton
        android:id="@+id/btnToCart"
        android:layout_width="40dp"
        android:layout_height="40dp"
        style="@style/ImageButtonBuyIt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvBookAuthor"
        style="@style/TextViewParagraphMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBookPhoto"
        app:layout_constraintTop_toBottomOf="@id/tvBookTitle"
        tools:text="Автор А.А. (2001 г.)"/>

    <TextView
        android:id="@+id/tvBookGenre"
        style="@style/TextViewParagraphMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBookPhoto"
        app:layout_constraintTop_toBottomOf="@id/tvBookAuthor"
        tools:text="Проза"/>

    <TextView
        android:id="@+id/tvBookPrice"
        style="@style/TextViewParagraphLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivBookPhoto"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="130.00 руб."/>

</androidx.constraintlayout.widget.ConstraintLayout>