<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ItemBasic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:padding="12dp"
    >


    <TextView
        android:id="@+id/tvCartItemTitle"
        style="@style/TextViewParagraphMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvCartItemCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Товар 1Товар1Товар1Товар 1Товар 1Товар1" />

    <TextView
        android:id="@+id/tvCartItemCount"
        style="@style/TextViewParagraphMedium"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textAlignment="textEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvCartItemPrice"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2 шт." />

    <TextView
        android:id="@+id/tvCartItemPrice"
        style="@style/TextViewParagraphMedium"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textAlignment="textEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnRemoveItem"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="120.00 руб."/>

    <ImageButton
        android:id="@+id/btnRemoveItem"
        android:layout_width="36dp"
        android:layout_height="36dp"
        style="@style/ImageButtonCloseRemove"

        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>